{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build backend",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/backend/HomeAutomation.Api/HomeAutomation.Api.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start API without debugging",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/backend/HomeAutomation.Api"],
      "problemMatcher": []
    },
    {
      "label": "Start React development server",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "--", "--clearScreen", "false"],
      "options": { "cwd": "${workspaceFolder}/src/frontend/home-automation-web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(.+):(\\d+):(\\d+): (.+)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:.*http://localhost:5173"
        }
      }
    }
  ]
}
