{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Automation API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build backend",
      "program": "${workspaceFolder}/src/backend/HomeAutomation.Api/bin/Debug/net10.0/HomeAutomation.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/HomeAutomation.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    },
    {
      "name": "Home Automation web",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "Start React development server",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/frontend/home-automation-web"
    }
  ],
  "compounds": [
    {
      "name": "Home Automation (API + web)",
      "configurations": ["Home Automation API", "Home Automation web"],
      "stopAll": true
    }
  ]
}
